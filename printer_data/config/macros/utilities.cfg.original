#######################################
# Beacon Homing Macros
#######################################
# These macros reduce stepper current during sensorless homing
# to improve stall detection reliability. They are called automatically
# by the Beacon module via home_gcode_pre/post_x/y in plugins/beacon.cfg

[gcode_macro _BEACON_HOME_PRE_X]
description: Reduce X stepper current before sensorless homing
gcode:
    SET_TMC_CURRENT STEPPER=stepper_x CURRENT=0.55

[gcode_macro _BEACON_HOME_POST_X]
description: Move away from endstop and restore X stepper current after homing
gcode:
    G1 X20 F1200
    M400
    SET_TMC_CURRENT STEPPER=stepper_x CURRENT={printer.configfile.settings['tmc2240 stepper_x'].run_current}

[gcode_macro _BEACON_HOME_PRE_Y]
description: Reduce Y stepper current before sensorless homing
gcode:
    SET_TMC_CURRENT STEPPER=stepper_y CURRENT=0.45

[gcode_macro _BEACON_HOME_POST_Y]
description: Move away from endstop and restore Y stepper current after homing
gcode:
    G1 Y10 F1200
    M400
    SET_TMC_CURRENT STEPPER=stepper_y CURRENT={printer.configfile.settings['tmc2240 stepper_y'].run_current}


#######################################
# Conditional Homing
#######################################

[gcode_macro _CG28]
description: Home all axes only if not already homed
gcode:
    {% if "xyz" not in printer.toolhead.homed_axes %}
        G28
    {% endif %}


#######################################
# Maintenance Macros
#######################################

[gcode_macro MOVE_HEAD]
description: Move toolhead around in a pattern after lubricating rods
gcode:
    {% set speed = params.SPEED|default(10000)|float %}
    _CG28
    G1 Z10 F600                                         # Move bed away from nozzle
    {% for i in range(10) %}
        G1 X0 Y0 F{speed}
        G1 X305 Y305 F{speed}
        G1 X0 Y305 F{speed}
        G1 X305 Y305 F{speed}
    {% endfor %}
    G1 X152.5 Y152.5 F{speed}                           # Return to center

[gcode_macro LUBE_APPLY]
description: Work freshly applied lube into the linear bearings
gcode:
    {% set num_loops = params.LOOPS|default(4)|int %}
    G28
    {% for i in range(1, num_loops) %}
        G0 X5 Y5 Z10 F2400
        G0 X295 Y295 Z275 F2400
    {% endfor %}
    G0 X150 Y150 Z10 F3600                              # Return to print ready position


#######################################
# Temperature Macros
#######################################
# These override Klipper's default M109, M190, M141, M191 commands
# to use TEMPERATURE_WAIT for more precise temperature control

[gcode_macro M141]
description: Set chamber heater temperature
gcode:
    {% if printer["heater_generic chamber"] is defined %}
        {% set s = params.S|float %}
        SET_HEATER_TEMPERATURE HEATER=chamber TARGET={s}
    {% endif %}

[gcode_macro M191]
description: Set and wait for chamber temperature
gcode:
    {% if printer["heater_generic chamber"] is defined %}
        {% set s = params.S|float %}
        M141 {% for p in params %}{'%s%s' % (p, params[p])}{% endfor %}
        {% if s != 0 %}
            TEMPERATURE_WAIT SENSOR="heater_generic chamber" MINIMUM={s-2}
        {% endif %}
    {% endif %}

[gcode_macro M109]
description: Set and wait for hotend temperature (within 2C minimum, 5C maximum)
rename_existing: M109.1
gcode:
    {% set s = params.S|float %}
    M104 {% for p in params %}{'%s%s' % (p, params[p])}{% endfor %}
    {% if s != 0 %}
        TEMPERATURE_WAIT SENSOR=extruder MINIMUM={s-2} MAXIMUM={s+5}
    {% endif %}

[gcode_macro M190]
description: Set and wait for bed temperature (within 2C minimum, 5C maximum)
rename_existing: M190.1
gcode:
    {% set s = params.S|float %}
    M140 {% for p in params %}{'%s%s' % (p, params[p])}{% endfor %}
    {% if s != 0 %}
        TEMPERATURE_WAIT SENSOR=heater_bed MINIMUM={s-2} MAXIMUM={s+5}
    {% endif %}