#######################################
# Beacon Thermal Expansion Compensation
#######################################
# RatOS-based thermal expansion compensation system for Beacon contact probing.
# Measures your specific hotend's thermal expansion coefficient by probing
# at two temperatures, then automatically applies the correct Z offset
# compensation based on print temperature.
#
# This is a more accurate alternative to the fixed expansion_factor in
# _APPLY_NOZZLE_OFFSET (macros/nozzle_offset.cfg).
#
# BEFORE ENABLING:
# 1. Rename this file from .disable to .cfg
# 2. Comment out or remove expansion_factor calculation in _APPLY_NOZZLE_OFFSET
#    (macros/nozzle_offset.cfg) to avoid double-applying thermal compensation
# 3. Uncomment _BEACON_SET_NOZZLE_TEMP_OFFSET and _BEACON_REMOVE_NOZZLE_TEMP_OFFSET
#    in PRINT_START and PRINT_END (currently commented out in print_end.cfg)
# 4. Run BEACON_CALIBRATE_NOZZLE_TEMP_OFFSET once to measure your hotend
# 5. Review variables.cfg to confirm nozzle_expansion_coefficient was saved
#
# See: https://github.com/YanceyA/BeaconPrinterTools


#######################################
# Configuration Variables
#######################################

[gcode_macro BEACON_VARS]
description: Configuration variables for Beacon thermal expansion compensation
variable_beacon_contact_calibration_temp: 150           # Nozzle temperature used as reference for calibration
variable_beacon_contact_expansion_compensation: True    # Enable/disable thermal expansion compensation
variable_beacon_contact_expansion_multiplier: 1.0       # Fine-tune multiplier - 1.1 = 10% less squish, 0.9 = 10% more squish
gcode:
    # Variable storage macro - no gcode needed


#######################################
# Initialization
#######################################

[delayed_gcode _BEACON_INIT]
initial_duration: 0.1                                   # Run 0.1 seconds after Klipper starts
gcode:
    _BEACON_SET_NOZZLE_TEMP_OFFSET RESET=True           # Reset any previously applied offset on startup


#######################################
# Calibration Macros
#######################################
# Run BEACON_CALIBRATE_NOZZLE_TEMP_OFFSET once to measure your hotend's
# thermal expansion coefficient. Results are saved to variables.cfg.
# Only needs to be re-run if you change your hotend or nozzle.

[gcode_macro BEACON_CALIBRATE_NOZZLE_TEMP_OFFSET]
description: Measure hotend thermal expansion coefficient - run once after hotend changes
variable_reference_z: 0.0
gcode:
    {% set z_speed = (printer.configfile.settings['stepper_z'].homing_speed)|float * 60 %}
    {% set z_hop = (printer.configfile.settings['beacon'].home_z_hop)|float %}
    {% set safe_home_x = (printer.configfile.settings.stepper_x.position_max) / 2 %}
    {% set safe_home_y = (printer.configfile.settings.stepper_y.position_max) / 2 %}

    # Home if needed
    {% if printer.toolhead.homed_axes != "xyz" %}
        G28
    {% endif %}

    # Z_TILT if configured
    {% if printer.z_tilt is defined and not printer.z_tilt.applied %}
        SET_DISPLAY_TEXT MSG="Z-Tilt adjust"
        {% if printer.configfile.settings["gcode_macro FAST_Z_TILT"] is defined %}
            {% if printer.configfile.settings['beacon'].default_probe_method != contact %}
                FAST_Z_TILT
            {% endif %}
        {% else %}
            Z_TILT_ADJUST
        {% endif %}
        G28 Z
    {% endif %}

    # Settle mechanics before calibration
    RESPOND MSG="Settling bed mechanics..."
    {% for i in range(10) %}
        beacon_poke speed=3 top=5 bottom=-0.6
    {% endfor %}

    # Measure at 150C (reference/cold temp)
    RESPOND MSG="Measuring at 150C reference temperature..."
    _BEACON_PROBE_NOZZLE_TEMP_OFFSET TEMP=150
    _BEACON_STORE_NOZZLE_TEMP_OFFSET TEMP=150

    # Measure at 250C (hot temp)
    RESPOND MSG="Measuring at 250C print temperature..."
    _BEACON_PROBE_NOZZLE_TEMP_OFFSET TEMP=250
    _BEACON_STORE_NOZZLE_TEMP_OFFSET TEMP=250

    # Second pass for accuracy
    RESPOND MSG="Second pass at 150C for accuracy..."
    _BEACON_PROBE_NOZZLE_TEMP_OFFSET TEMP=150
    _BEACON_STORE_NOZZLE_TEMP_OFFSET TEMP=150

    RESPOND MSG="Second pass at 250C for accuracy..."
    _BEACON_PROBE_NOZZLE_TEMP_OFFSET TEMP=250
    _BEACON_STORE_NOZZLE_TEMP_OFFSET TEMP=250

    # Return to safe position
    G0 Z{z_hop} F{z_speed}
    G0 X{safe_home_x} Y{safe_home_y}

    # Turn off hotend
    SET_HEATER_TEMPERATURE HEATER=extruder TARGET=0

    # Report results
    _BEACON_NOZZLE_TEMP_OFFSET


#######################################
# Internal Calibration Sub-Macros
#######################################

[gcode_macro _BEACON_PROBE_NOZZLE_TEMP_OFFSET]
description: Heat nozzle to target temp and probe Z position
gcode:
    {% set temp = params.TEMP|int %}
    {% set z_speed = (printer.configfile.settings['stepper_z'].homing_speed)|float * 60 %}

    RESPOND MSG="Waiting for nozzle to reach {temp}C..."
    SET_HEATER_TEMPERATURE HEATER=extruder TARGET={temp}
    TEMPERATURE_WAIT SENSOR=extruder MINIMUM={temp} MAXIMUM={temp + 2}

    RESPOND MSG="Waiting 60s for thermal expansion to stabilise..."
    G4 P60000

    RESPOND MSG="Probing at {temp}C..."
    PROBE PROBE_METHOD=contact SAMPLES=5 SAMPLES_TOLERANCE=0.005 SAMPLES_TOLERANCE_RETRIES=10 SAMPLES_RESULT=median
    G4 P2000                                            # Wait 2s for beacon_query to return valid value
    BEACON_QUERY

    G0 Z5 F{z_speed}                                   # Raise Z after probing

[gcode_macro _BEACON_STORE_NOZZLE_TEMP_OFFSET]
description: Store probe result for thermal expansion coefficient calculation
gcode:
    {% set temp = params.TEMP|int %}
    {% set svv = printer.save_variables.variables %}
    {% set last_z = printer.beacon.last_z_result|default(0)|float %}

    {% if temp == 150 %}
        # Store reference Z position at cold temp
        SET_GCODE_VARIABLE MACRO=BEACON_CALIBRATE_NOZZLE_TEMP_OFFSET VARIABLE=reference_z VALUE={last_z}
    {% else %}
        # Calculate and save expansion coefficient (difference between hot and cold)
        {% set reference_z = printer["gcode_macro BEACON_CALIBRATE_NOZZLE_TEMP_OFFSET"].reference_z|default(0)|float %}
        SAVE_VARIABLE VARIABLE=nozzle_expansion_coefficient VALUE={(last_z - reference_z)}
    {% endif %}

[gcode_macro _BEACON_NOZZLE_TEMP_OFFSET]
description: Report current nozzle expansion coefficient from variables.cfg
gcode:
    {% set svv = printer.save_variables.variables %}
    RESPOND MSG={'"Expansion coefficient: %.6f"' % svv.nozzle_expansion_coefficient}


#######################################
# Runtime Offset Application
#######################################
# These macros are called at print start and end to apply/remove
# the thermal expansion Z offset based on print temperature.
# See PRINT_END for commented-out calls to enable these.

[gcode_macro _BEACON_SET_NOZZLE_TEMP_OFFSET]
description: Apply thermal expansion Z offset based on current hotend temperature
gcode:
    {% set reset = true if params.RESET|default(false)|lower == 'true' else false %}
    {% set z_speed = (printer.configfile.settings['stepper_z'].homing_speed)|float * 60 %}
    {% set beacon_contact_calibration_temp = params.probing_temp|default(150)|int %}
    {% set beacon_contact_expansion_multiplier = printer["gcode_macro BEACON_VARS"].beacon_contact_expansion_multiplier|default(1.0)|float %}
    {% set beacon_contact_expansion_compensation = true if printer["gcode_macro BEACON_VARS"].beacon_contact_expansion_compensation|default(false)|lower == 'true' else false %}
    {% set svv = printer.save_variables.variables %}

    {% if reset %}
        # Reset applied offset on startup or print end
        SAVE_VARIABLE VARIABLE=nozzle_expansion_applied_offset VALUE=0
    {% else %}
        {% if beacon_contact_expansion_compensation %}
            {% set nozzle_expansion_coefficient = svv.nozzle_expansion_coefficient|default(0)|float %}
            {% set applied_offset = svv.nozzle_expansion_applied_offset|default(0)|float %}
            {% set temp = printer['extruder'].target|float %}

            # Calculate expansion offset based on temperature delta from calibration temp
            {% set temp_offset = temp - beacon_contact_calibration_temp %}
            {% set expansion_offset = beacon_contact_expansion_multiplier * (temp_offset * (nozzle_expansion_coefficient / 100)) %}

            # Apply offset (remove previously applied offset first)
            {% set new_offset = ((-applied_offset) + expansion_offset) %}
            SET_GCODE_OFFSET Z_ADJUST={new_offset} MOVE=1 SPEED={z_speed}
            SAVE_VARIABLE VARIABLE=nozzle_expansion_applied_offset VALUE={expansion_offset}

            RESPOND MSG={'"Nozzle expansion offset of %.6fmm applied"' % (expansion_offset)}
        {% endif %}
    {% endif %}

[gcode_macro _BEACON_REMOVE_NOZZLE_TEMP_OFFSET]
description: Remove previously applied thermal expansion Z offset at print end
gcode:
    {% set z_speed = (printer.configfile.settings['stepper_z'].homing_speed)|float * 60 %}
    {% set beacon_contact_expansion_compensation = true if printer["gcode_macro BEACON_VARS"].beacon_contact_expansion_compensation|default(false)|lower == 'true' else false %}

    {% if beacon_contact_expansion_compensation %}
        {% set svv = printer.save_variables.variables %}
        {% set applied_offset = svv.nozzle_expansion_applied_offset|default(0)|float %}

        # Remove the previously applied offset
        SET_GCODE_OFFSET Z_ADJUST={(-applied_offset)} MOVE=0 SPEED={z_speed}
    {% endif %}


#######################################
# Multiplier Fine-Tuning
#######################################
# Run BEACON_APPLY_MULTIPLIER after a print where you've adjusted
# the Z offset via babystepping to automatically calculate and save
# a refined expansion multiplier for better first layer accuracy.

[gcode_macro BEACON_APPLY_MULTIPLIER]
description: Calculate refined expansion multiplier from babystep Z offset adjustments
gcode:
    {% set beacon_contact_calibration_temp = printer["gcode_macro BEACON_VARS"].beacon_contact_calibration_temp|default(150)|int %}
    {% set beacon_contact_expansion_compensation = true if printer["gcode_macro BEACON_VARS"].beacon_contact_expansion_compensation|default(false) %}

    {% if beacon_contact_expansion_compensation %}
        {% set svv = printer.save_variables.variables %}
        {% set nozzle_expansion_coefficient = svv.nozzle_expansion_coefficient|default(0)|float %}
        {% set beacon_contact_expansion_multiplier = svv.nozzle_expansion_coefficient_multiplier|default(1.0)|float %}

        # Calculate new multiplier based on current Z offset adjustment
        {% set print_temp = printer['extruder'].target|float %}
        {% set z_offset = printer.gcode_move.homing_origin.z|float %}
        {% set temp_delta = print_temp - beacon_contact_calibration_temp %}
        {% set coefficient_per_degree = nozzle_expansion_coefficient / 100 %}
        {% set z_offset_per_degree = z_offset / temp_delta %}
        {% set new_multiplier = z_offset_per_degree / coefficient_per_degree %}

        SAVE_VARIABLE VARIABLE=nozzle_expansion_coefficient_multiplier VALUE={new_multiplier}
        RESPOND MSG={'"New multiplier: %.6f - saved and activated."' % new_multiplier}
    {% endif %}