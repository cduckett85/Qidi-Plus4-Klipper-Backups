max_power = 1.0
cycle_time = 0.0100
hardware_pwm = false
kick_start_time = 0.200
off_below = 0.3
shutdown_speed = 0

[heater_fan chamber_heater_fan]
pin = PA4
max_power = 1.0
shutdown_speed = 0
kick_start_time = 0.5
heater = chamber
fan_speed = 1.0
off_below = 0
heater_temp = 40

[heater_fan hotend_fan]
