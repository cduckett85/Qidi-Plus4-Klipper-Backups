heater_temp = 50.0
fan_speed = 1.0
off_below = 0

[heater_fan hotend_fan2]
pin = Toolhead: PB4
max_power = 1.0
shutdown_speed = 1.0
kick_start_time = 0.5
heater = extruder
heater_temp = 50.0
fan_speed = 1.0
off_below = 0

[heater_fan hotend_fan3]
pin = Toolhead: PB10
max_power = 1.0
shutdown_speed = 1.0
kick_start_time = 0.5
heater = extruder
heater_temp = 50.0
fan_speed = 1.0
