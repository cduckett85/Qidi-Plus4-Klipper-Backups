[tmc2240 stepper_y]
cs_pin = PB9
spi_software_sclk_pin = PA5
spi_software_mosi_pin = PA7
spi_software_miso_pin = PA6
spi_speed = 200000
run_current = 1.07
interpolate = False
stealthchop_threshold = 0
diag0_pin = !PC0
driver_sgt = 1
rref = 12000

[tmc2209 stepper_z]
uart_pin = PB7
