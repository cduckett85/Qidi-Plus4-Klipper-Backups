sense_resistor = 0.075

[tmc2209 stepper_z1]
uart_pin = PC5
run_current = 1.07
interpolate = False
stealthchop_threshold = 9999999999
diag_pin = ^PC12
sense_resistor = 0.075

[z_tilt]
z_positions = 
	-17.5,138.5
	335.7,138.5
points = 
	0,138.5
	255,138.5
speed = 150
horizontal_move_z = 10
retries = 5
retry_tolerance = 0.013

[screws_tilt_adjust]
horizontal_move_z = 5
screw_thread = CW-M4
speed = 300
screw1 = 0,20
screw1_name = Front left
screw2 = 260,20
screw2_name = Front right
screw3 = 260,280
screw3_name = Back right
screw4 = 0,280
screw4_name = Back left
