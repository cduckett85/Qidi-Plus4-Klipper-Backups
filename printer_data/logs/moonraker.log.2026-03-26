[update_manager crowsnest]
type = git_repo
origin = https://github.com/mainsail-crew/crowsnest.git
path = ~/crowsnest
install_script = tools/pkglist.sh

[update_manager FreeDi]
type = git_repo
channel = stable
origin = https://github.com/Phil1988/FreeDi
path = ~/FreeDi
virtualenv = ~/klippy-env
requirements = requirements.txt
managed_services = FreeDi
info_tags = 
	desc=FreeDi

[update_manager mobileraker]
type = git_repo
origin = https://github.com/Clon1998/mobileraker_companion.git
path = /home/mks/mobileraker_companion
primary_branch = main
env = /home/mks/mobileraker-env/bin/python
requirements = /home/mks/mobileraker_companion/scripts/mobileraker-requirements.txt
install_script = /home/mks/mobileraker_companion/scripts/install.sh
managed_services = mobileraker

[update_manager klipper-backup]
type = git_repo
origin = https://github.com/Staubgeborener/klipper-backup.git
path = ~/klipper-backup
primary_branch = main
managed_services = moonraker

[update_manager beacon]
type = git_repo
channel = dev
origin = https://github.com/beacon3d/beacon_klipper.git
path = ~/beacon_klipper
env = ~/klippy-env/bin/python
requirements = requirements.txt
install_script = install.sh
is_system_service = False
managed_services = klipper
info_tags = 
	desc=Beacon Surface Scanner

[update_manager klipper_tmc_autotune]
type = git_repo
channel = dev
origin = https://github.com/andrewmcgr/klipper_tmc_autotune
path = /home/mks/klipper_tmc_autotune
primary_branch = main
managed_services = klipper

[update_manager Klippain-ShakeTune]
type = git_repo
origin = https://github.com/Frix-x/klippain-shaketune.git
path = ~/klippain_shaketune
virtualenv = /home/mks/klippy-env
requirements = requirements.txt
system_dependencies = system-dependencies.json
primary_branch = main
managed_services = klipper

[update_manager KAMP]
type = git_repo
origin = https://github.com/kyleisah/Klipper-Adaptive-Meshing-Purging.git
path = ~/Klipper-Adaptive-Meshing-Purging
primary_branch = main
managed_services = klipper

